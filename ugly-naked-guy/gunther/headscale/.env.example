TZ=Europe/Minsk

# Public name of this control server. DNS for the hostname must point at the
# public address you port-forward, and the URL must be https on port 443.
HEADSCALE_TLS_LETSENCRYPT_HOSTNAME=hs.example.com
HEADSCALE_SERVER_URL=https://hs.example.com

# Contact for the Let's Encrypt account. Not written into the certificate.
HEADSCALE_ACME_EMAIL=you@example.com

# MagicDNS suffix, for example laptop.tailnet.internal.
# Must not be the server hostname, and must not be a parent of it.
# hs.example.com cannot use example.com here. This name needs no public DNS.
# Set it before the first node joins.
HEADSCALE_DNS_BASE_DOMAIN=tailnet.internal
